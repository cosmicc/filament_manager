# Docker Compose and Swarm deployment values. Copy this file to the ignored
# `.env`, replace the deployment-specific examples, and never commit the
# populated file. Swarm does not load `.env` automatically, so export it before
# command-line deployment.

# Images and published application addresses. `latest` is for initial testing;
# pin the successful workflow's sha-<commit> tag or digest in production.
FILAMENT_MANAGER_IMAGE=ghcr.io/cosmicc/filament-manager:latest
SPOOLMAN_IMAGE=ghcr.io/donkie/spoolman:0.23.1
FILAMENT_MANAGER_BASE_URL=https://filament-manager.internal.example
FILAMENT_MANAGER_ALLOWED_HOSTS=filament-manager.internal.example
FILAMENT_MANAGER_CORS_ORIGINS=
FILAMENT_MANAGER_SECURE_COOKIES=true
FILAMENT_MANAGER_LOG_LEVEL=INFO
FILAMENT_MANAGER_PUBLIC_PORT=8080
SPOOLMAN_PUBLIC_PORT=7912
TZ=America/Detroit

# Optional outbound Bugsnag monitoring. The browser notifier key is public by
# design but is kept deployment-specific so other installations never report
# into this project. Enable performance separately after error reporting works.
BUGSNAG_ENABLED=false
BUGSNAG_API_KEY=
BUGSNAG_RELEASE_STAGE=production
BUGSNAG_BROWSER_PERFORMANCE_ENABLED=false

# Remote PostgreSQL. Use different hexadecimal passwords for the two roles.
POSTGRES_HOST=postgres.internal.example
POSTGRES_PORT=5432
FILAMENT_MANAGER_DB_NAME=filament_manager
FILAMENT_MANAGER_DB_USERNAME=filament_user
FILAMENT_MANAGER_DB_SSLMODE=disable
FILAMENT_MANAGER_DB_PASSWORD=replace_with_unique_hex_password
SPOOLMAN_DB_NAME=spoolman
SPOOLMAN_DB_USERNAME=spoolman_user
SPOOLMAN_DB_QUERY=ssl=disable
SPOOLMAN_DB_PASSWORD=replace_with_different_unique_hex_password

# Spoolman service and browser integration.
SPOOLMAN_INTERNAL_URL=http://spoolman:8000
SPOOLMAN_PUBLIC_URL=http://spoolman.internal.example:7912
SPOOLMAN_CORS_ORIGIN=https://fluidd.internal.example
SPOOLMAN_METRICS_ENABLED=TRUE
SPOOLMAN_REQUEST_TIMEOUT_SECONDS=10
SPOOLMAN_RECONCILE_INTERVAL_MINUTES=1

# One supported Moonraker printer. Leave WEBSOCKET_URL empty to derive it from
# MOONRAKER_BASE_URL. Leave API_KEY empty when Moonraker does not require one.
MOONRAKER_PRINTER_ID=printer-1
MOONRAKER_PRINTER_NAME='Workshop Printer'
MOONRAKER_BASE_URL=http://printer.internal.example:7125
MOONRAKER_WEBSOCKET_URL=
MOONRAKER_API_KEY=
MOONRAKER_NOZZLE_DIAMETER_MM=0.6

# Optional Google Sheets publication. JSON must be compact and one line.
GOOGLE_ENABLED=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBLISH_INTERVAL_SECONDS=30
GOOGLE_WRITE_BATCH_SIZE=200
GOOGLE_UNEXPECTED_EDIT_POLICY=warn_and_overwrite

# Application tuning. These defaults are safe starting values.
FILAMENT_MANAGER_DATABASE_POOL_SIZE=10
FILAMENT_MANAGER_DATABASE_MAX_OVERFLOW=10
FILAMENT_MANAGER_DATABASE_STATEMENT_TIMEOUT_MS=30000
FILAMENT_MANAGER_DATABASE_AUTO_MIGRATE=true
FILAMENT_MANAGER_DATABASE_MIGRATION_LOCK_TIMEOUT_SECONDS=300
SYNC_MAX_RETRY_ATTEMPTS=12
SYNC_OUTBOX_WORKERS=2
SYNC_OUTBOX_LOCK_TIMEOUT_SECONDS=300
MOONRAKER_STATE_INTERVAL_SECONDS=10
MOONRAKER_PRINT_INTERVAL_SECONDS=10
MOONRAKER_INFO_INTERVAL_SECONDS=300
LOW_SPOOL_THRESHOLD_PERCENT=25
MEASUREMENT_INCREASE_TOLERANCE_PERCENT=5
MEASUREMENT_INCREASE_TOLERANCE_G=25
PLATE_SELECTION_POLICY=require
VERIFY_MESH_LOADED=true
SCALE_ENABLED=false
NFC_ENABLED=false
STABLE_WINDOW_SECONDS=10
STABLE_VARIANCE_G=2
REPLAY_WINDOW_SECONDS=300
SESSION_LIFETIME_HOURS=720
SESSION_IDLE_MINUTES=10080
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Sensitive values are ordinary stack environment variables for now. Generate
# unique values and restrict access to Portainer, the Swarm manager, and `.env`.
# POSTGRES_ADMIN_PASSWORD is used only by local Compose.
POSTGRES_ADMIN_PASSWORD=replace_with_local_compose_admin_password

# Optional independent-stack objects.
FILAMENT_SERVICES_NETWORK=filament-services
FILAMENT_MANAGER_DATA_VOLUME=filament_manager_data
SPOOLMAN_DATA_VOLUME=spoolman_data
