[Unit]
Description=Filament Manager Cura Workstation Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@@AGENT_EXECUTABLE@@ run
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="-%h/.config/Filament Manager Agent" "-%h/.local/share/Filament Manager Agent" -%h/.local/share/cura -%h/.var/app/com.ultimaker.cura/data/cura -%h/snap/cura-slicer/current/.local/share/cura -%h/snap/cura/current/.local/share/cura

[Install]
WantedBy=default.target
