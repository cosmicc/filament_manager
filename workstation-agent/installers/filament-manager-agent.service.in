[Unit]
Description=Filament Manager Cura Workstation Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@@AGENT_EXECUTABLE@@ run
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The installer creates the two required private roots before this unit starts.
# Keep optional Cura roots prefixed with '-' because not every packaging format
# exists on every workstation.
ReadWritePaths="%h/.config/Filament Manager Agent" "%h/.local/share/Filament Manager Agent" -%h/.local/share/cura -%h/.var/app/com.ultimaker.cura/data/cura -%h/snap/cura-slicer/current/.local/share/cura -%h/snap/cura/current/.local/share/cura

[Install]
WantedBy=default.target
