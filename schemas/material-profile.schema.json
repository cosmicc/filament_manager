{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "filament_product_id",
    "printer_id",
    "nozzle_diameter_mm",
    "version",
    "status",
    "extruder_temp_c",
    "bed_temp_c",
    "flow_percent",
    "filament_density_g_cm3"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "filament_product_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_template_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "printer_id": {
      "type": "string"
    },
    "nozzle_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "calibration_in_progress",
        "validated",
        "published",
        "superseded",
        "archived"
      ]
    },
    "chamber_temp_c": {
      "type": [
        "number",
        "null"
      ]
    },
    "extruder_temp_c": {
      "type": "number"
    },
    "bed_temp_c": {
      "type": "number"
    },
    "flow_percent": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "print_speed_mm_s": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "retraction_distance_mm": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "retraction_speed_mm_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cooling_enabled": {
      "type": "boolean"
    },
    "cooling_min_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "cooling_max_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "support_overhang_angle_deg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 90
    },
    "tree_max_branch_angle_deg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 90
    },
    "pressure_advance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "filament_density_g_cm3": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "preferred_build_plate_surface_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^P[1-9][0-9]*b?$",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "cura_extensions": {
      "type": "object"
    }
  }
}
