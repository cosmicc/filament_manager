{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calibration Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "filament_product_id",
    "printer_id",
    "nozzle_diameter_mm",
    "status",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "filament_product_id": {
      "type": "string",
      "format": "uuid"
    },
    "printer_id": {
      "type": "string"
    },
    "nozzle_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "build_plate_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        null
      ]
    },
    "status": {
      "enum": [
        "draft",
        "in_progress",
        "ready_to_publish",
        "published",
        "cancelled"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "order",
          "key",
          "required",
          "status"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "key": {
            "enum": [
              "temperature",
              "flow",
              "pressure_advance",
              "retraction",
              "overhang",
              "ironing"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "completed",
              "needs_review",
              "skipped"
            ]
          },
          "result": {}
        }
      }
    }
  }
}
