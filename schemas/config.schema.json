{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/filament_manager/config.schema.json",
  "title": "Filament Manager Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "database",
    "spoolman",
    "moonraker",
    "google",
    "sync",
    "plates",
    "devices"
  ],
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "timezone": {
          "const": "America/Detroit"
        },
        "log_level": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "auth_mode": {
          "enum": [
            "local",
            "trusted_proxy",
            "oidc"
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url_file"
      ],
      "properties": {
        "url_file": {
          "type": "string",
          "minLength": 1
        },
        "pool_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_overflow": {
          "type": "integer",
          "minimum": 0
        },
        "statement_timeout_ms": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "spoolman": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "websocket_enabled": {
          "type": "boolean"
        },
        "full_reconcile_interval_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "public_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "moonraker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "printers"
      ],
      "properties": {
        "printers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "base_url",
              "websocket_url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "base_url": {
                "type": "string",
                "format": "uri"
              },
              "websocket_url": {
                "type": "string"
              },
              "api_key_file": {
                "type": "string"
              },
              "nozzle_diameter_mm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "google": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "spreadsheet_id": {
          "type": "string"
        },
        "service_account_file": {
          "type": "string"
        },
        "publish_interval_seconds": {
          "type": "integer",
          "minimum": 10
        },
        "write_batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "unexpected_edit_policy": {
          "enum": [
            "warn_and_overwrite",
            "pause_publication"
          ]
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retry_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "outbox_workers": {
          "type": "integer",
          "minimum": 1
        },
        "low_spool_threshold_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "plates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_codes": {
          "type": "array",
          "items": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4",
              "P5"
            ]
          }
        },
        "selection_policy": {
          "enum": [
            "off",
            "warn",
            "require"
          ]
        },
        "verify_mesh_loaded": {
          "type": "boolean"
        }
      }
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale_enabled": {
          "type": "boolean"
        },
        "nfc_enabled": {
          "type": "boolean"
        },
        "stable_window_seconds": {
          "type": "number",
          "minimum": 1
        },
        "stable_variance_g": {
          "type": "number",
          "minimum": 0
        },
        "replay_window_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
